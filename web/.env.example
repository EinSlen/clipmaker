# Groq (LLM gratuit — recommandé). Crée une clé sur https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq par défaut (rapide et bon en français)
GROQ_MODEL=llama-3.3-70b-versatile

# Optionnel : override Claude (premium). Laissé vide → Groq utilisé.
ANTHROPIC_API_KEY=

# Binaire Python utilisé pour piloter TiktokAutoUploader (login + upload "cookies")
PYTHON_BIN=python

# YouTube Data API v3 (officielle, gratuite). Indispensable sur hébergeur cloud
# (Render, Fly, etc.) car YouTube bloque les IPs datacenter pour yt-dlp / Invidious.
# Crée un projet sur https://console.cloud.google.com/, active "YouTube Data API v3",
# génère une API key.
YOUTUBE_API_KEY=

# Liste custom d'instances Invidious (séparées par virgules) — utilisé en fallback
# si YOUTUBE_API_KEY n'est pas définie. Vide = liste par défaut.
INVIDIOUS_INSTANCES=

# Publication YouTube Shorts via OAuth + YouTube Data API.
YOUTUBE_UPLOAD_PROVIDER=youtube-data-api
YOUTUBE_ALLOW_PUBLIC_UPLOAD=false
# Bundle OAuth multi-comptes encodé en base64. `npm run youtube:oauth:setup`
# le crée directement comme secret GitHub; ne le colle jamais dans le dépôt.
YOUTUBE_OAUTH_ACCOUNTS_B64=
YOUTUBE_API_DRY_RUN=true

# Automatic CC BY music discovery for monetizable game videos.
# Create a free application/client ID at https://devportal.jamendo.com/
# Without it, Auto Discovery falls back to uploaded licensed tracks or the
# original generated soundtrack.
JAMENDO_CLIENT_ID=

# Obligatoire pour la publication automatique YouTube/TikTok. À saisir aussi
# dans le panneau d'export afin qu'une personne externe ne puisse pas déclencher un upload.
CLIPMAKER_UPLOAD_TOKEN=

# Daily publisher. Copy config/publisher.example.json to config/publisher.json
# before enabling the Docker publisher profile.
PUBLISHER_CONFIG=/repo/web/config/publisher.json
PUBLISHER_BASE_URL=http://clipmaker:3000
PUBLISHER_DRY_RUN=true

# Comment-driven story channel (game id "story-comments"). Everything below is
# free: Groq writes the French episode, Cloudflare Workers AI draws the shots
# and speaks the narration through MeloTTS, and the YouTube Data API reads the
# comments left on the previous episode.
# Create the Workers AI token with the "Workers AI: Read" permission only.
# https://console.groq.com/keys · https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Override the writer model without touching the Studio model.
GROQ_STORY_MODEL=
