{
  "name": "clipmaker-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:games && npm run test:publisher",
    "test:games": "node scripts/test-game-renders.mjs",
    "test:publisher": "node --test src/automation/*.test.mjs",
    "test:render-smoke": "node scripts/test-game-renders.mjs --smoke",
    "publisher": "node scripts/publisher.mjs",
    "publisher:doctor": "node scripts/publisher.mjs doctor",
    "publisher:status": "node scripts/publisher.mjs status",
    "youtube:doctor": "node scripts/youtube-agent.mjs doctor",
    "youtube:auth": "node scripts/youtube-agent.mjs auth"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "youtube-videos-uploader": "https://github.com/EinSlen/youtube-uploader/archive/acb21315e0333fc351297e2488773045cc26f5cc.tar.gz"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "minimatch": "3.1.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "tar-fs": "2.1.5",
    "ws": "8.21.1"
  }
}
