# Copier ce fichier vers .youtube-agent/.env, puis renseigner les valeurs OAuth.
YOUTUBE_DRY_RUN=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN_EXPIRES_IN=
YOUTUBE_REDIRECT_URI=http://localhost:8788/callback
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_NOTIFY_SUBSCRIBERS=false
